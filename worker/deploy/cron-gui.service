[Unit]
Description=Cron Worker GUI (gunicorn + Flask)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# El daemon del worker escucha en 127.0.0.1:8080 (solo localhost);
# Apache (worker/deploy/apache-cron-gui.conf) hace de reverse proxy en el :80.
WorkingDirectory=/opt/worker-cron/worker
ExecStart=/opt/worker-cron/worker/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8080 "cronworker.webgui:app"
Restart=always
RestartSec=10
User=cronworker
Group=cronworker

[Install]
WantedBy=multi-user.target
