[Unit]
Description=Cron Scheduler Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cron-worker
ExecStart=/opt/cron-worker/venv/bin/python -m cronworker.scheduler
Restart=always
RestartSec=10
User=cronworker
Group=cronworker

[Install]
WantedBy=multi-user.target
